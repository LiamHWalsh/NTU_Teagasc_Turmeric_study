// Nextflow configuration for metagenomics pipeline

// Process execution settings
process {
    executor = 'slurm'
    queue = 'Priority,Background,GPU'
    
    // Default resources
    cpus = 4
    memory = '32 GB'
    
    // Error handling
    errorStrategy = 'retry'
    maxRetries = 2
    
    // Process-specific settings
    withName: fasnicar_preprocess {
        cpus = 4
        memory = '16 GB'
    }
    
    withName: interleave_reads {
        cpus = 4
        memory = '16 GB'
    }
    
    withName: metaphlan_profile {
        cpus = 10
        memory = '32 GB'
    }
}

// SLURM executor settings
executor {
    name = 'slurm'
    queueSize = 2
    submitRateLimit = '10 sec'
}

// Email notifications
notification {
    enabled = true
    to = params.email
}

// Execution reports
report {
    enabled = true
    file = "${params.output_dir}/reports/execution_report.html"
}

timeline {
    enabled = true
    file = "${params.output_dir}/reports/timeline.html"
}

trace {
    enabled = true
    file = "${params.output_dir}/reports/trace.txt"
}